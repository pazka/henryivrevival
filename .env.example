# henryivrevival environment. Copy to henryivrevival.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough, then the
# OWNER fills OPENAI_API_KEY (never the agent; on the cutover it is moved from the legacy .env, DEPLOY.md §1c).
# `hosh-deploy register` checks the names on the `# required:` line are non-empty (values never printed).
# required: OPENAI_API_KEY

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/henryivrevival:v1.2.0'
APP_BIND='127.0.0.1:9139'

# --- app ---
# Secret: OpenAI key of its own project (with a monthly budget set on the OpenAI side). Without it the app
# does not start.
OPENAI_API_KEY=
# Optional overrides (defaults in myOpenAi.ts / chatGuard.ts; uncomment to change):
# OPENAI_CHAT_MODEL=gpt-5.6-sol
# OPENAI_TTS_MODEL=tts-1
# OPENAI_MAX_COMPLETION_TOKENS=500
# CHAT_RATE_PER_MINUTE=6
# CHAT_RATE_PER_HOUR=60
# CHAT_DAILY_BUDGET=500
# Proxy hops in front of the app (Traefik → docker-proxy = 1, the port is loopback-only).
# TRUST_PROXY_HOPS=1
